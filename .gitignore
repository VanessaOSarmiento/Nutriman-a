/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Uu]serSettings/

# Asset meta data should only be ignored if they are for a file that is also ignored
!/[Aa]ssets/**/*.meta

# Video editor temp files
/[Aa]ssets/**/*.tmp
/[Aa]ssets/**/*.tmp.meta

# Autogenerated JetBrains Rider project files
.idea/
*.sln
*.csproj
*.unitypackage

# External packages
/[Pp]ackages/*
!/[Pp]ackages/manifest.json
!/[Pp]ackages/packages-lock.json

# TextMesh Pro generated resources
[Aa]ssets/[Tt]ext[Mm]esh [Pp]ro/

# WebGL build folders
/[Bb]in/

# Mac OS X
.DS_Store
*.swp
*.lock
*.bak

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
