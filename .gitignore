# This .gitignore file is optimized for Unity projects.
# It ensures that large cache files, autogenerated files, IDE settings, and OS-specific files are not tracked.

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Uu]serSettings/

# Asset meta data should only be ignored if they are for a file that is also ignored
!/[Aa]ssets/**/*.meta

# Video editor temp files
/[Aa]ssets/**/*.tmp
/[Aa]ssets/**/*.tmp.meta

# Unity Editor and package manager files
/[Pp]ackages/*
!/[Pp]ackages/manifest.json
!/[Pp]ackages/packages-lock.json
!/[Pp]ackages/manifest.json.meta
!/[Pp]ackages/packages-lock.json.meta

# TextMesh Pro generated resources
[Aa]ssets/[Tt]ext[Mm]esh [Pp]ro/

# WebGL build folders
/[Bb]in/

# Crashlytics / Crash Reports
/[Cc]rash[Rr]eport[Aa]nalyses/

# Autogenerated IDE project files and directories
.idea/
.vs/
.vscode/
*.sln
*.slnx
*.csproj
*.unityproj
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity package and builds output
*.unitypackage
*.apk
*.aab
sysinfo.txt

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.lock
*.bak

